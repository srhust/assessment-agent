# 密钥与本地配置：任何情况下都不进仓库
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# 运行产物（锚定仓库根：evidence/**/runs/ 是入库的冻结回放证据，不得被波及）
/runs/
/results/
data/private/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 图片缓存（原始题图默认随 runs/ 忽略，示例图与合成数据集除外）
data/**/*.png
data/**/*.jpg
!data/**/samples/*.png
!data/figure/images/*.png
# 评测基准的图片与区域裁剪**必须入库**：数据集要求"原始截图+金标准+哈希"可整体复现/审计
!data/screens/images/*.png
!data/screens/regions/**/*.png
!data/benchmark_real/**/*.png
!data/screens/images/*.png
!data/screens/regions/**/*.png

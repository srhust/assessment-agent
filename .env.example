# ---------------------------------------------------------------------------
# assessment-agent 环境变量示例
# 使用方法：复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交。
# 代码与仓库中不保存任何真实密钥。
# ---------------------------------------------------------------------------

# 任意兼容 OpenAI Chat Completions 协议的服务（OpenAI / Azure OpenAI / vLLM /
# Ollama(/v1) / DeepSeek / Moonshot / 自建网关 等）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-with-your-key

# 文本模型（Router 兜底分类、解析辅助、Verifier 交叉校验）
LLM_TEXT_MODEL=gpt-4o-mini

# 视觉模型（截图题干/选项抽取）；留空表示未配置视觉能力
LLM_VISION_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# 部分网关不支持 response_format={"type":"json_object"}，可关闭后由客户端容错解析
LLM_JSON_MODE=true

# 离线模式：true 时完全跳过模型调用，只运行确定性 Skill（数字计算/数列/逻辑）
# 不填时：有 LLM_API_KEY 则为 false，否则自动为 true
# ASSESSMENT_OFFLINE=false

# 目录（默认在项目根目录下）
# ASSESSMENT_RUNS_DIR=runs
# ASSESSMENT_RESULTS_DIR=results
# ASSESSMENT_DATA_DIR=data

# 规则路由的最小得分；低于该值时若配置了模型则回退到 LLM 分类
# ROUTER_RULE_THRESHOLD=1.0

# Verifier 是否额外做一次 LLM 交叉校验（默认关闭，会增加成本）
# VERIFIER_USE_LLM=false
